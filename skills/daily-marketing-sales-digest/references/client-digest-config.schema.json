{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyDigestConfig",
  "type": "object",
  "required": ["client_slug", "display_name", "accounts", "delivery"],
  "properties": {
    "client_slug": { "type": "string" },
    "display_name": { "type": "string" },
    "agency_name": { "type": "string", "default": "Hexanovate" },
    "timezone": { "type": "string", "default": "Asia/Kolkata" },
    "cadence": { "type": "string", "enum": ["daily", "weekly"], "default": "daily" },
    "window_days": { "type": "integer", "minimum": 1, "maximum": 90, "default": 1 },
    "accounts": {
      "type": "object",
      "required": ["crm"],
      "properties": {
        "crm": {
          "type": "object",
          "required": ["outletId"],
          "properties": {
            "outletId": { "type": "string", "minLength": 1 }
          }
        },
        "google_ads": {
          "type": "object",
          "required": ["customer_id"],
          "properties": {
            "customer_id": { "type": "string", "pattern": "^[0-9]{10}$" },
            "label": { "type": "string" }
          }
        },
        "meta": {
          "type": "object",
          "required": ["ad_account_id"],
          "properties": {
            "ad_account_id": { "type": "string", "pattern": "^act_" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["email", "whatsapp"],
      "properties": {
        "email": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "format": "email",
              "description": "Gmail account that sends the digest (must match authenticated user-gmail MCP inbox, or use send-as alias if supported)"
            },
            "to": { "type": "array", "items": { "type": "string", "format": "email" }, "minItems": 1 },
            "cc": { "type": "array", "items": { "type": "string", "format": "email" } },
            "reply_to": { "type": "string", "format": "email" }
          }
        },
        "whatsapp": {
          "type": "object",
          "required": ["recipient_numbers"],
          "properties": {
            "integrated_number": {
              "type": "string",
              "pattern": "^[0-9]{10,15}$",
              "description": "MSG91 WhatsApp Business sender number (digits only, with country code)"
            },
            "recipient_numbers": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9]{10,15}$" },
              "minItems": 1,
              "description": "Who receives the daily WhatsApp brief"
            },
            "recipients": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "name": { "type": "string" },
                  "phone": { "type": "string", "pattern": "^[0-9]{10,15}$" }
                }
              }
            },
            "template_type": { "type": "string", "default": "simple" },
            "template_name": { "type": "string" },
            "language_code": { "type": "string", "default": "en" },
            "redact_pii": { "type": "boolean", "default": false },
            "use_template_outside_24h": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "crm": { "type": "boolean", "default": true },
        "meta": { "type": "boolean", "default": true },
        "google_ads": { "type": "boolean", "default": true },
        "whatsapp_delivery": { "type": "boolean", "default": true },
        "clarity": { "type": "boolean", "default": false },
        "spur": { "type": "boolean", "default": false }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "accent_color": { "type": "string", "default": "#0066FF" },
        "logo_url": { "type": "string", "format": "uri" }
      }
    },
    "clarity_project": { "type": "string" },
    "saved_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "min_spend_inr": { "type": "number", "default": 1000 },
        "cpl_increase_pct": { "type": "number", "default": 25 },
        "stale_lead_hours": { "type": "integer", "default": 48 }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "crm_dashboard": { "type": "string", "format": "uri" },
        "meta_ads_manager": { "type": "string", "format": "uri" }
      }
    }
  }
}
